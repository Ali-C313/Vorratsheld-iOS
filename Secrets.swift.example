import Foundation

// Vorlage: kopieren, in Secrets.swift umbenennen und eigene Werte eintragen
enum Secrets {
    // emailjs.com (kostenlos bis 200 Mails/Monat)
    static let emailJsServiceId = "DEINE_SERVICE_ID"
    static let emailJsTemplateId = "DEINE_TEMPLATE_ID"
    static let emailJsPublicKey = "DEIN_PUBLIC_KEY"
    static let emailJsPrivateKey = "DEIN_PRIVATE_KEY"

    // Solange die Platzhalter drinstehen, wird nur in Firestore gespeichert
    static var isEmailJsConfigured: Bool {
        !emailJsServiceId.hasPrefix("DEINE")
    }
}
