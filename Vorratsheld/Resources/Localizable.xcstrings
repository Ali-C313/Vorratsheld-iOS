    "help_intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل لديك مشكلة أو اقتراح أو سؤال؟ راسلنا – سنرد عليك عبر البريد الإلكتروني."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hast du ein Problem, einen Verbesserungsvorschlag oder eine Frage? Schreib uns – wir melden uns per E-Mail bei dir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do you have a problem, a suggestion or a question? Write to us – we’ll get back to you by email."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Tienes un problema, una sugerencia o una pregunta? Escríbenos y te responderemos por correo electrónico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as un problème, une suggestion ou une question ? Écris-nous – nous te répondrons par e-mail."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai un problema, un suggerimento o una domanda? Scrivici – ti risponderemo via e-mail."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masz problem, sugestię lub pytanie? Napisz do nas – odpowiemy e-mailem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Есть проблема, предложение или вопрос? Напишите нам – мы ответим по эл. почте."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir sorunun, önerin ya da sorun mu var? Bize yaz – sana e-postayla dönüş yapacağız."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Маєте проблему, пропозицію чи запитання? Напишіть нам – ми відповімо електронною поштою."
          }
        }
      }
    },
