    "lock_forgot_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم تسجيل خروجك وستسجل الدخول مجددًا بالبريد الإلكتروني وكلمة المرور. سيتم إيقاف قفل التطبيق."
