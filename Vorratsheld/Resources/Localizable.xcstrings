    "onboarding_3_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سننبهك قبل أن تنتهي صلاحية أي شيء. هكذا يقل ما يُرمى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir melden uns, bevor etwas abläuft. So landet weniger im Müll."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We’ll let you know before something expires. So less ends up in the bin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te avisamos antes de que algo caduque. Así acaba menos en la basura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous te prévenons avant qu’un produit ne périme. Moins de choses finissent à la poubelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti avvisiamo prima che qualcosa scada. Così meno cibo finisce nella spazzatura."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damy znać, zanim coś się przeterminuje. Mniej trafi do kosza."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мы сообщим до того, как что-то испортится. Так меньше окажется в мусоре."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir şeyin süresi dolmadan önce haber veririz. Böylece daha az şey çöpe gider."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ми повідомимо, перш ніж щось зіпсується. Так менше опиниться у смітнику."
          }
        }
      }
    },
