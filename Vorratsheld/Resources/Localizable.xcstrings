    "profile_email_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند إدخال بريد إلكتروني جديد سنرسل لك رابط تأكيد. لن يتغير إلا بعد التأكيد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei einer neuen E-Mail-Adresse schicken wir dir einen Bestätigungslink. Erst danach wird sie geändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you enter a new email address, we’ll send you a confirmation link. It will only change after you confirm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si introduces un nuevo correo electrónico, te enviaremos un enlace de confirmación. Solo cambiará después de confirmarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si tu saisis une nouvelle adresse e-mail, nous t’enverrons un lien de confirmation. Elle ne sera modifiée qu’après confirmation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se inserisci un nuovo indirizzo e-mail, ti invieremo un link di conferma. Verrà modificato solo dopo la conferma."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po wpisaniu nowego adresu e-mail wyślemy Ci link potwierdzający. Adres zmieni się dopiero po potwierdzeniu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если вы укажете новый адрес эл. почты, мы отправим ссылку для подтверждения. Адрес изменится только после подтверждения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni bir e-posta adresi girersen sana bir onay bağlantısı göndeririz. Adres ancak onayladıktan sonra değişir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо ви вкажете нову адресу ел. пошти, ми надішлемо посилання для підтвердження. Адресу буде змінено лише після підтвердження."
          }
        }
      }
    },
