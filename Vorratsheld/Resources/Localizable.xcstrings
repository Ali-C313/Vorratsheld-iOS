    "applock_intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احمِ مخزونك برمز PIN. ويمكنك بدلاً من ذلك الفتح بسهولة باستخدام Face ID أو البصمة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schütze deinen Vorrat mit einem PIN. Wenn du willst, entsperrst du stattdessen bequem mit Face ID oder Fingerabdruck."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protect your pantry with a PIN. If you like, unlock it with Face ID or your fingerprint instead."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protege tu despensa con un PIN. Si quieres, desbloquea con Face ID o tu huella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protège tes réserves avec un code PIN. Si tu veux, déverrouille plutôt avec Face ID ou ton empreinte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proteggi la tua dispensa con un PIN. Se vuoi, sblocca invece con Face ID o impronta."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chroń swoje zapasy PIN-em. Jeśli chcesz, odblokowuj wygodnie Face ID lub odciskiem palca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Защитите свои запасы PIN-кодом. При желании разблокируйте с помощью Face ID или отпечатка пальца."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stokunu bir PIN ile koru. İstersen bunun yerine Face ID veya parmak izi ile kolayca açabilirsin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Захистіть свої запаси PIN-кодом. За бажанням розблоковуйте за допомогою Face ID або відбитка пальця."
          }
        }
      }
    },
    "applock_no_biometrics" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توجد قياسات حيوية مُعدّة على هذا الجهاز. ستفتح القفل برمز PIN."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Gerät ist keine Biometrie eingerichtet. Du entsperrst mit deinem PIN."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No biometrics are set up on this device. You unlock with your PIN."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay biometría configurada en este dispositivo. Desbloqueas con tu PIN."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune biométrie n’est configurée sur cet appareil. Tu déverrouilles avec ton code PIN."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su questo dispositivo non è configurata la biometria. Sblocchi con il PIN."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na tym urządzeniu nie skonfigurowano biometrii. Odblokowujesz PIN-em."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На этом устройстве не настроена биометрия. Разблокировка по PIN-коду."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu cihazda biyometri ayarlı değil. PIN’inle açarsın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На цьому пристрої не налаштовано біометрію. Розблокування за PIN-кодом."
          }
        }
      }
    },
