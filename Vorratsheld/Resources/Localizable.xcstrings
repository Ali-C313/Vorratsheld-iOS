    "delete_account_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم حذف حسابك وملفك الشخصي وجميع المنتجات نهائيًا. يرجى إدخال كلمة المرور للتأكيد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Konto, dein Profil und alle Produkte werden endgültig gelöscht. Bitte gib zur Bestätigung dein Passwort ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your account, your profile and all products will be permanently deleted. Please enter your password to confirm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta, tu perfil y todos los productos se eliminarán definitivamente. Introduce tu contraseña para confirmar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton compte, ton profil et tous tes produits seront définitivement supprimés. Saisis ton mot de passe pour confirmer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo account, il tuo profilo e tutti i prodotti verranno eliminati definitivamente. Inserisci la password per confermare."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje konto, profil i wszystkie produkty zostaną trwale usunięte. Wpisz hasło, aby potwierdzić."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш аккаунт, профиль и все продукты будут удалены безвозвратно. Введите пароль для подтверждения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesabın, profilin ve tüm ürünlerin kalıcı olarak silinecek. Onaylamak için lütfen şifreni gir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш обліковий запис, профіль і всі продукти буде остаточно видалено. Введіть пароль для підтвердження."
          }
        }
      }
    },
