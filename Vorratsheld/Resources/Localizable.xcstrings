    "onboarding_1_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وجّه الكاميرا نحو الباركود – وسنجلب الاسم والصورة تلقائيًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte die Kamera auf den Barcode – Name und Bild holen wir automatisch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Point the camera at the barcode – we’ll fetch the name and picture automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apunta la cámara al código de barras: obtenemos el nombre y la imagen automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pointe la caméra sur le code-barres – nous récupérons automatiquement le nom et l’image."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inquadra il codice a barre – nome e immagine li recuperiamo automaticamente."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skieruj aparat na kod kreskowy – nazwę i zdjęcie pobierzemy automatycznie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наведите камеру на штрихкод – название и фото мы подтянем автоматически."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamerayı barkoda tut – adı ve resmi otomatik olarak alırız."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наведіть камеру на штрихкод – назву й фото ми підтягнемо автоматично."
          }
        }
      }
    },
    "onboarding_1_title" : {
      "extractionState" : "manual",
      "localizations" : {
