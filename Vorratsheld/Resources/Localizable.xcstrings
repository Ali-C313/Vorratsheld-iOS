    "product_delete_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم حذف «%1$@» نهائيًا من مخزونك. لا يمكن التراجع عن ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ wird endgültig aus deinem Vorrat entfernt. Das kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” will be permanently removed from your pantry. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» se eliminará definitivamente de tu despensa. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %1$@ » sera définitivement retiré de ton stock. Cette action est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» verrà rimosso definitivamente dalla tua dispensa. L’operazione non può essere annullata."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@” zostanie trwale usunięty z Twoich zapasów. Tej operacji nie można cofnąć."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» будет безвозвратно удалён из ваших запасов. Это действие нельзя отменить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” stokundan kalıcı olarak silinecek. Bu işlem geri alınamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» буде остаточно видалено з ваших запасів. Цю дію неможливо скасувати."
          }
        }
      }
    },
