    "onboarding_4_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضع نجمة على منتجاتك المفضلة – وستُضاف مباشرة إلى قائمة التسوق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markiere Lieblingsprodukte mit einem Stern – sie landen direkt auf deiner Einkaufsliste."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mark favorite products with a star – they go straight onto your shopping list."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marca tus productos favoritos con una estrella: irán directos a tu lista de la compra."
