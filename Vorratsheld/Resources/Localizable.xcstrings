    "onboarding_2_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الثلاجة والمخزن مرتبان حسب تاريخ انتهاء الصلاحية – بألوان تُظهر فورًا ما هو عاجل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kühlschrank und Kammer übersichtlich, sortiert nach Ablaufdatum – mit Farben, die sofort zeigen, was eilt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fridge and pantry neatly sorted by expiry date – with colors that show right away what’s urgent."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nevera y despensa ordenadas por fecha de caducidad, con colores que muestran al instante lo urgente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réfrigérateur et garde-manger triés par date de péremption – avec des couleurs qui montrent tout de suite ce qui presse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frigorifero e dispensa ordinati per data di scadenza – con colori che mostrano subito cosa è urgente."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lodówka i spiżarnia uporządkowane według daty ważności – z kolorami, które od razu pokazują, co pilne."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Холодильник и кладовая отсортированы по сроку годности – цвета сразу показывают, что срочно."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buzdolabı ve kiler son kullanma tarihine göre düzenli – neyin acil olduğunu hemen gösteren renklerle."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Холодильник і комора впорядковані за терміном придатності – кольори одразу показують, що терміново."
          }
        }
      }
    },
    "onboarding_2_title" : {
      "extractionState" : "manual",
      "localizations" : {
